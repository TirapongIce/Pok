PORT=4001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=huay_aud_db
DB_USER=huay_aud
DB_PASSWORD=replace-with-a-local-test-password
DB_SSL_CA=


# --- บัญชีผู้ดูแลระบบ (ต้องตั้งก่อนขึ้น production) ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# ใส่ข้อมูลจำลอง (ผู้ใช้ demo / ผลรางวัล demo) ค่าเริ่มต้น: true เมื่อไม่ใช่ production
SEED_DEMO_DATA=false

# --- ดึงผลหวยรัฐบาลไทยอัตโนมัติจาก GLO ---
THAI_SYNC_AUTO=true
THAI_SYNC_INTERVAL_MS=600000
THAI_RESULT_READY_TIME=16:00
GLO_API_BASE=https://www.glo.or.th/api
GLO_API_TIMEOUT_MS=15000

# Sessions expire after this many hours, including across server restarts.
SESSION_TTL_HOURS=8
# Explicit one-time admin password reset. Turn off after use.
SUPERADMIN_RESET_PASSWORD=false

# Serve client/dist from the API origin (Docker enables this).
SERVE_CLIENT=false
